<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Fixtures imitate real-world code, which uses APIs marked experimental
         (e.g. RemoveAllResilienceHandlers). Suppressing the warning doesn't change behaviour. -->
    <NoWarn>$(NoWarn);EXTEXP0001</NoWarn>
  </PropertyGroup>
</Project>
