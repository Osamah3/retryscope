<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>RetryScope.Model</RootNamespace>
    <Description>Intermediate representation (ResilienceGraph) shared by RetryScope's extractor, topology importer and simulator.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Positional record parameters are documented with <param>; don't fail the build on members we deliberately leave undocumented. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RetryScope.Model.Tests" />
  </ItemGroup>

</Project>
