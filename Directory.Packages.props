<Project>
  <!-- Central Package Management: every NuGet version is pinned here (versions taken from upstream release tags). -->
  <ItemGroup>
    <!-- Tests run on Microsoft.Testing.Platform (opted in via global.json), which xunit.v3 includes. -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Used by fixtures and the behaviour oracle: the libraries whose behaviour RetryScope models. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Polly" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <!-- Extractor. Roslyn 5.0.0 is the compiler shipped with the .NET 10.0.100 SDK (dotnet/roslyn tag NET-SDK-10.0.100).
         MSBuildWorkspace loads projects in an out-of-process BuildHost that locates MSBuild itself, so no MSBuildLocator. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.0.0" />
  </ItemGroup>
</Project>
